#!/usr/bin/env bash
# @file aivideo
# @author zhangbaohong
# @date 2026-09-17
# @description 启动脚本：解析 AIVIDEO_MODE，自动准备 .env/构建，分发 docker/host/local 模式执行 CLI；`serve` 子命令常驻启动镜头墙工作台服务
# @see https://github.com/1241751430/AIVideo.git
# AI Video Agent launcher.
# Usage: ./aivideo <command> [args...]
#        ./aivideo serve    — 常驻启动镜头墙工作台（浏览器访问 http://127.0.0.1:8787）
#
# Behavior:
#   - Prefer Docker Compose when Docker is available (first run auto-builds the image).
#   - Fallback to host-level Node (pnpm) when Docker is not available.
#   - Bootstraps .env on first run so users don't need a separate `init` step.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

STATE_DIR=".aivideo"
DOCKER_STAMP="$STATE_DIR/.docker-built"
FIRST_RUN_STAMP="$STATE_DIR/.first-run-complete"

# 功能：判断是否首次运行（首跑标记文件不存在）
# @author zhangbaohong @date 2026-09-17 @see https://github.com/1241751430/AIVideo.git
is_first_run() {
  [ ! -f "$FIRST_RUN_STAMP" ]
}

# 功能：首次运行时向 stderr 打印一次性初始化提示
# @author zhangbaohong @date 2026-09-17 @see https://github.com/1241751430/AIVideo.git
print_first_run_notice() {
  local mode="$1"
  if is_first_run; then
    echo "[aivideo] First run setup (${mode} mode)." >&2
    echo "[aivideo] One-time setup may create .env and prepare dependencies; later runs skip these steps unless files change." >&2
  fi
}

# 功能：写入首次运行完成标记，避免后续重复提示
# @author zhangbaohong @date 2026-09-17 @see https://github.com/1241751430/AIVideo.git
mark_first_run_complete() {
  mkdir -p "$STATE_DIR"
  touch "$FIRST_RUN_STAMP"
}

# 功能：当 .env 缺失时从 .env.example 自动生成
# @author zhangbaohong @date 2026-09-17 @see https://github.com/1241751430/AIVideo.git
ensure_env_file() {
  if [ ! -f ".env" ] && [ -f ".env.example" ]; then
    cp .env.example .env
    echo "[aivideo] Created .env from .env.example. Add API keys there if you need remote models." >&2
  fi
}

# 功能：判断指定命令是否存在于 PATH 中
# @author zhangbaohong @date 2026-09-17 @see https://github.com/1241751430/AIVideo.git
have_cmd() { command -v "$1" >/dev/null 2>&1; }

# 功能：检测 docker 守护进程与 docker compose 子命令是否可用
# @author zhangbaohong @date 2026-09-17 @see https://github.com/1241751430/AIVideo.git
docker_available() {
  have_cmd docker || return 1
  docker info >/dev/null 2>&1 || return 1
  if docker compose version >/dev/null 2>&1; then return 0; fi
  return 1
}

# 功能：镜像缺失或 Docker 相关文件更新时按需构建镜像（docker 模式公共前置）
# @author zhangbaohong @date 2026-09-17 @see https://github.com/1241751430/AIVideo.git
ensure_docker_image() {
  mkdir -p "$STATE_DIR"
  if [ ! -f "$DOCKER_STAMP" ] || [ "Dockerfile" -nt "$DOCKER_STAMP" ] || [ "docker-compose.yml" -nt "$DOCKER_STAMP" ] || [ "aivideo.config.yaml" -nt "$DOCKER_STAMP" ]; then
    echo "[aivideo] Preparing Docker image (first run or Docker files changed)..." >&2
    docker compose build
    touch "$DOCKER_STAMP"
  fi
}

# 功能：校验宿主 Node/pnpm，并在指定入口产物缺失时执行一次 install + build（host 模式公共前置）
# @author zhangbaohong @date 2026-09-17 @see https://github.com/1241751430/AIVideo.git
require_host_runtime() {
  local entry="$1"
  if ! have_cmd node; then
    echo "[aivideo] Node.js 20+ is required but was not found." >&2
    exit 1
  fi
  if [ ! -f "$entry" ]; then
    if ! have_cmd pnpm; then
      echo "[aivideo] pnpm is required to build the project. Install pnpm 10+ first." >&2
      exit 1
    fi
    echo "[aivideo] First run: installing dependencies and building..." >&2
    pnpm install
    pnpm build
  fi
}

# 功能：按需构建 Docker 镜像后通过 docker compose 运行 CLI
# @author zhangbaohong @date 2026-09-17 @see https://github.com/1241751430/AIVideo.git
run_docker() {
  print_first_run_notice "Docker"
  ensure_docker_image
  mark_first_run_complete
  exec docker compose run --rm aivideo "$@"
}

# 功能：校验 Node/pnpm 并按需安装构建后，用宿主机 Node 直接运行 CLI
# @author zhangbaohong @date 2026-09-17 @see https://github.com/1241751430/AIVideo.git
run_host() {
  mkdir -p "$STATE_DIR"
  print_first_run_notice "host"
  require_host_runtime "apps/cli/dist/index.js"
  mark_first_run_complete
  exec node apps/cli/dist/index.js "$@"
}

# 功能：docker 模式常驻启动工作台服务（compose up server，仅映射宿主 127.0.0.1:8787）
# @author zhangbaohong @date 2026-09-17 @see https://github.com/1241751430/AIVideo.git
serve_docker() {
  print_first_run_notice "Docker serve"
  ensure_docker_image
  mark_first_run_complete
  echo "[aivideo] Shot-wall workbench: http://127.0.0.1:8787 (container: open-folder degrades to host path hint)" >&2
  exec docker compose up server
}

# 功能：host 模式常驻启动工作台服务（直接 node apps/server/dist/index.js）
# @author zhangbaohong @date 2026-09-17 @see https://github.com/1241751430/AIVideo.git
serve_host() {
  mkdir -p "$STATE_DIR"
  print_first_run_notice "host serve"
  require_host_runtime "apps/server/dist/index.js"
  mark_first_run_complete
  echo "[aivideo] Shot-wall workbench: http://127.0.0.1:8787" >&2
  exec node apps/server/dist/index.js
}

# 功能：按 AIVIDEO_MODE 分发 serve 子命令（auto 模式 docker 优先，与 CLI 行为一致）
# @author zhangbaohong @date 2026-09-17 @see https://github.com/1241751430/AIVideo.git
run_serve() {
  MODE="${AIVIDEO_MODE:-auto}"
  case "$MODE" in
    docker) serve_docker ;;
    host|local) serve_host ;;
    auto|*)
      if docker_available; then
        serve_docker
      else
        serve_host
      fi
      ;;
  esac
}

ensure_env_file

if [ "${1:-}" = "serve" ]; then
  shift
  run_serve "$@"
fi

MODE="${AIVIDEO_MODE:-auto}"
case "$MODE" in
  docker) run_docker "$@" ;;
  host|local) run_host "$@" ;;
  auto|*)
    if docker_available; then
      run_docker "$@"
    else
      run_host "$@"
    fi
    ;;
esac
