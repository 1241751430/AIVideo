{
  "name": "aivideo-agent",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm build && pnpm -r test:compiled",
    "check": "pnpm build && pnpm test",
    "check:headers": "bash scripts/check-headers.sh",
    "test:worker": "python3 -m unittest discover -s workers/media -p \"test_*.py\" -v",
    "cli": "node apps/cli/dist/index.js",
    "server": "node apps/server/dist/index.js",
    "dev:server": "pnpm --filter @aivideo/server dev"
  }
}
